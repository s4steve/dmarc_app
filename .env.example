# Required. Generate each with: openssl rand -hex 32
SECRET_KEY=
ELASTICSEARCH_PASSWORD=
REDIS_PASSWORD=

ELASTICSEARCH_URL=http://localhost:9200

# First system admin, created on startup only when the users index is empty (password: 12-72 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# production (default) returns generic error messages; development shows sanitized details
ENVIRONMENT=production

# Managed SPF (optional): flattened SPF hosted on a dns_server_db control plane.
# Off until all three are set. See "Managed SPF" in README.md.
DNS_CONTROL_PLANE_URL=
DNS_CONTROL_PLANE_TOKEN=
SPF_ZONE=
# Development only: allow plain http to a non-loopback control plane
DNS_CONTROL_PLANE_ALLOW_HTTP=false
